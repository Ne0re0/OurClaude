# OurCodex environment variables

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-please
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Dashboard and Responses API proxy share this port.
WEB_PORT=3000

DB_TYPE=sqlite
DB_PATH=/data/codex-proxy.db
POSTGRES_DSN=

# API-key accounts use the public Responses API. ChatGPT OAuth accounts use
# the Codex backend and retain their ChatGPT-Account-ID header.
OPENAI_API_URL=https://api.openai.com/v1
CHATGPT_CODEX_URL=https://chatgpt.com/backend-api/codex
OAUTH_REFRESH_URL=https://auth.openai.com/oauth/token
OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# Defaults to JWT_SECRET when empty.
ENCRYPTION_KEY=
JWT_EXPIRY_HOURS=24
POOL_RESET_INTERVAL_MINUTES=
HEALTH_CHECK_INTERVAL_MINUTES=
USER_MAX_RPM=0
CORS_ORIGINS=*
REDIS_URL=
RESPONSE_CACHE_TTL_SECONDS=0
SYSTEM_PROMPT_INJECT=

# The ourcodex wrapper configures a custom Codex model provider automatically:
#   ourcodex login http://localhost:3000 sk-proxy-...
#   ourcodex
